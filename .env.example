# Supabase Environment Configuration Template for RoadFix
# Copy this file to .env and insert your project credentials.

# Supabase API URL (from Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Client Key (Safe for client-side use)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
